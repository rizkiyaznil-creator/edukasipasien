---
// Kalkulator perkiraan waktu mulai obat penunda haid (untuk umrah/haji).
// Menghitung untuk noretisteron; untuk pil KB ditampilkan panduan teks.
// Alat bantu perkiraan — tetap ikuti anjuran & resep dokter.
---

<div class="calc" id="haid-calc">
  <p class="calc-desc">
    Perkiraan waktu berdasarkan siklus Anda. <strong>Alat bantu</strong> — dosis,
    kelayakan, dan resep tetap ditentukan dokter.
  </p>

  <fieldset>
    <legend>Metode</legend>
    <label><input type="radio" name="hc-metode" value="noret" checked /> Noretisteron (mis. Primolut N)</label>
    <label><input type="radio" name="hc-metode" value="pil" /> Pil KB kombinasi</label>
  </fieldset>

  <div class="calc-field">
    <label for="hc-hpht">HPHT (hari pertama haid terakhir)</label>
    <input type="date" id="hc-hpht" />
  </div>
  <div class="calc-field">
    <label for="hc-siklus">Panjang siklus (hari)</label>
    <input type="number" id="hc-siklus" value="28" min="20" max="45" step="1" />
  </div>
  <div class="calc-field">
    <label for="hc-bersih">Tanggal terakhir perlu suci (mis. hari terakhir rangkaian ibadah)</label>
    <input type="date" id="hc-bersih" />
  </div>

  <div id="hc-hasil" class="calc-result" aria-live="polite">
    <p class="calc-result__hint">Isi tanggal untuk melihat perkiraan.</p>
  </div>
</div>

<script>
  const DAY = 86400000;
  const toUTC = (v: string): number | null => {
    if (!v) return null;
    const [y, m, d] = v.split('-').map(Number);
    if (!y || !m || !d) return null;
    return Date.UTC(y, m - 1, d);
  };
  const fmt = (ms: number) =>
    new Intl.DateTimeFormat('id-ID', { dateStyle: 'full', timeZone: 'UTC' }).format(new Date(ms));
  const todayUTC = () => {
    const n = new Date();
    return Date.UTC(n.getFullYear(), n.getMonth(), n.getDate());
  };
  const $ = (id: string) => document.getElementById(id);
  const hasil = $('hc-hasil');

  function metode() {
    return (document.querySelector('input[name="hc-metode"]:checked') as HTMLInputElement)?.value || 'noret';
  }
  function render(html: string) {
    if (hasil) hasil.innerHTML = html;
  }

  function compute() {
    const lmp = toUTC(($('hc-hpht') as HTMLInputElement).value);
    const cycle = Math.min(45, Math.max(20, Number(($('hc-siklus') as HTMLInputElement).value) || 28));
    const clean = toUTC(($('hc-bersih') as HTMLInputElement).value);
    if (lmp === null || clean === null) {
      render('<p class="calc-result__hint">Isi HPHT dan tanggal terakhir perlu suci.</p>');
      return;
    }
    const nextPeriod = lmp + cycle * DAY;
    const notes: string[] = [];

    if (metode() === 'pil') {
      render(`
        <dl class="calc-out">
          <div><dt>Perkiraan haid berikutnya</dt><dd>${fmt(nextPeriod)}</dd></div>
          <div><dt>Cara</dt><dd style="text-align:left">Lanjutkan <strong>pil aktif tanpa jeda</strong> (lewati pil kosong/plasebo) hingga <strong>${fmt(clean)}</strong>; setelah berhenti, haid umumnya datang beberapa hari kemudian.</dd></div>
        </dl>
        <p class="calc-result__hint" style="margin-top:.5rem">Sesuaikan dengan jenis pil Anda dan anjuran dokter.</p>`);
      return;
    }

    // Noretisteron
    if (nextPeriod > clean) {
      render(`
        <dl class="calc-out">
          <div><dt>Perkiraan haid berikutnya</dt><dd>${fmt(nextPeriod)}</dd></div>
          <div><dt>Catatan</dt><dd style="text-align:left">Perkiraan haid Anda jatuh <strong>setelah</strong> ${fmt(clean)} — kemungkinan <strong>tidak perlu menunda</strong>. Tetap konsultasikan ke dokter.</dd></div>
        </dl>`);
      return;
    }
    const start = nextPeriod - 3 * DAY;
    const afterPeriod = clean + 2 * DAY;
    const lama = Math.round((clean - start) / DAY);
    if (lama > 17) notes.push('Lama minum melebihi ± 2 minggu (17 hari) — sampaikan ke dokter.');
    if (start < todayUTC()) notes.push('Waktu mulai sudah/hampir lewat — segera konsultasi dokter.');

    render(`
      <dl class="calc-out">
        <div><dt>Perkiraan haid berikutnya</dt><dd>${fmt(nextPeriod)}</dd></div>
        <div><dt>Mulai minum noretisteron</dt><dd><strong>${fmt(start)}</strong> <span class="calc-out__sub">(5 mg, 3× sehari)</span></dd></div>
        <div><dt>Lanjutkan hingga</dt><dd>${fmt(clean)}, lalu berhenti</dd></div>
        <div><dt>Perkiraan haid datang</dt><dd>${fmt(afterPeriod)} <span class="calc-out__sub">(± 2–3 hari setelah berhenti)</span></dd></div>
        <div><dt>Lama minum</dt><dd>± ${lama} hari</dd></div>
      </dl>
      ${notes.length ? `<p class="calc-result__hint" style="margin-top:.5rem">⚠️ ${notes.join(' ')}</p>` : ''}`);
  }

  for (const el of Array.from(
    document.querySelectorAll('#haid-calc input')
  )) {
    el.addEventListener('input', compute);
  }
</script>
