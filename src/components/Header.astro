---
import { withBase } from '../lib/base';
import TopicSearch from './TopicSearch.astro';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/kamus', label: 'Kamus' },
  { href: '/tentang', label: 'Tentang' },
];
// Buang base path dari pathname agar perbandingan menu aktif tetap benar
// (mis. "/edukasipasien/kamus" -> "/kamus").
const base = withBase('/').replace(/\/$/, '');
const raw = Astro.url.pathname.replace(/\/$/, '') || '/';
const path = base && raw.startsWith(base) ? raw.slice(base.length) || '/' : raw;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={withBase('/')} aria-label="Temant — beranda">
      <svg class="logo" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#129e90" />
            <stop offset="1" stop-color="#0a655c" />
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="92" height="92" rx="22" fill="url(#lg)" />
        <g fill="none" stroke="#ffffff" stroke-width="8.5" stroke-linecap="round">
          <path d="M38 86 C 16 54, 48 46, 50 26" />
          <path d="M62 86 C 84 54, 52 46, 50 26" />
        </g>
      </svg>
      <span>Temant<small>Sahabat Ginekologi Onkologi</small></span>
    </a>
    <nav class="nav" aria-label="Navigasi utama">
      {
        links.map((l) => (
          <a href={withBase(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="container header-search">
    <TopicSearch />
  </div>
</header>

<style>
  .header-search {
    padding-bottom: 0.6rem;
  }
</style>
