---
import { withBase } from '../lib/base';
import TopicSearch from './TopicSearch.astro';

const links = [
  { href: '/', label: 'Beranda' },
  { href: '/kamus', label: 'Kamus' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/hubungi', label: 'Hubungi' },
  { href: '/profesional', label: 'Dokter' },
];
// Buang base path dari pathname agar perbandingan menu aktif tetap benar
// (mis. "/edukasipasien/kamus" -> "/kamus").
const base = withBase('/').replace(/\/$/, '');
const raw = Astro.url.pathname.replace(/\/$/, '') || '/';
const path = base && raw.startsWith(base) ? raw.slice(base.length) || '/' : raw;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={withBase('/')} aria-label="Medan Gyn Surgery — beranda">
      <svg class="logo" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#15938a" />
            <stop offset="1" stop-color="#0b5f58" />
          </linearGradient>
        </defs>
        <rect x="4" y="4" width="92" height="92" rx="22" fill="url(#lg)" />
        <g fill="none" stroke="#ffffff" stroke-width="8.5" stroke-linecap="round">
          <path d="M38 86 C 16 54, 48 46, 50 26" />
          <path d="M62 86 C 84 54, 52 46, 50 26" />
        </g>
      </svg>
      <span>Medan Gyn Surgery<small>Sahabat Ginekologi Onkologi</small></span>
    </a>
    <nav class="nav" aria-label="Navigasi utama">
      {
        links.map((l) => (
          <a
            href={withBase(l.href)}
            aria-current={isActive(l.href) ? 'page' : undefined}
            data-pro-gate={l.href === '/profesional' ? '' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="container header-search">
    <TopicSearch />
  </div>
</header>

<div class="modal-overlay" id="pro-gate" hidden>
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pro-gate-title"
    aria-describedby="pro-gate-desc"
  >
    <h2 class="modal__title" id="pro-gate-title">Untuk Tenaga Kesehatan</h2>
    <div class="modal__body" id="pro-gate-desc">
      <p>
        Bagian ini berisi ringkasan singkat dan <strong>alat bantu praktik</strong>
        yang ditujukan untuk <strong>tenaga medis profesional</strong> (dokter spesialis,
        residen, dan dokter umum).
      </p>
      <p>
        Seluruh materi dan kalkulator di dalamnya adalah <strong>alat bantu</strong> —
        <strong>bukan pengganti penilaian klinis</strong> maupun <strong>pedoman resmi
        terbaru</strong>.
      </p>
      <p class="modal__q"><strong>Apakah Anda seorang tenaga medis profesional?</strong></p>
    </div>
    <div class="modal__actions">
      <button type="button" class="btn btn--ghost" data-pro-cancel>Batal</button>
      <a class="btn" id="pro-gate-go" href="#">Ya, saya tenaga kesehatan — lanjutkan</a>
    </div>
  </div>
</div>

<style>
  .header-search {
    padding-bottom: 0.6rem;
  }
</style>

<script>
  const overlay = document.getElementById('pro-gate');
  const go = document.getElementById('pro-gate-go') as HTMLAnchorElement | null;
  const html = document.documentElement;
  const HOME = import.meta.env.BASE_URL || '/';
  const acked = () => {
    try {
      return sessionStorage.getItem('pro-ack') === '1';
    } catch {
      return false;
    }
  };
  const setAck = () => {
    try {
      sessionStorage.setItem('pro-ack', '1');
    } catch {
      /* abaikan */
    }
  };

  if (overlay && go) {
    let lastFocus: HTMLElement | null = null;

    const openNav = (href: string) => {
      go.dataset.mode = 'nav';
      go.setAttribute('href', href);
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      lastFocus = document.activeElement as HTMLElement;
      go.focus();
    };
    const closeNav = () => {
      overlay.hidden = true;
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    // Mode gerbang: halaman /profesional dibuka langsung tanpa konfirmasi sesi ini.
    if (html.classList.contains('pro-gated')) {
      go.dataset.mode = 'gate';
      go.setAttribute('href', '#');
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      go.focus();
    }

    // Tombol konfirmasi ("Ya, lanjutkan")
    go.addEventListener('click', (e) => {
      if (go.dataset.mode === 'gate') {
        e.preventDefault();
        setAck();
        html.classList.remove('pro-gated');
        overlay.hidden = true;
        document.body.style.overflow = '';
      } else {
        // mode nav: tandai lalu biarkan navigasi tautan berjalan
        setAck();
      }
    });

    // Intersepsi klik menu "Dokter"
    for (const g of Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-pro-gate]')
    )) {
      g.addEventListener('click', (e) => {
        if (acked()) return; // sudah konfirmasi sesi ini → lanjut langsung
        e.preventDefault();
        openNav(g.getAttribute('href') || HOME);
      });
    }

    // "Batal" / menolak
    const cancel = () => {
      if (go.dataset.mode === 'gate') {
        location.href = HOME; // menolak di halaman pro → kembali ke Beranda
      } else {
        closeNav();
      }
    };
    for (const c of Array.from(overlay.querySelectorAll('[data-pro-cancel]')))
      c.addEventListener('click', cancel);

    // Esc / klik area luar: hanya di mode nav (dinonaktifkan di mode gerbang).
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay && go.dataset.mode !== 'gate') closeNav();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden && go.dataset.mode !== 'gate') closeNav();
    });
  }
</script>
