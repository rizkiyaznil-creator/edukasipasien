---
import BaseLayout from '../layouts/BaseLayout.astro';
import Callout from '../components/Callout.astro';

const email = 'info@medangynsurgery.com';
const emailHref = `mailto:${email}?subject=${encodeURIComponent(
  'Pesan dari medangynsurgery.com'
)}`;
const igUser = 'medangynsurgery';
const igHref = `https://instagram.com/${igUser}`;
---

<BaseLayout
  title="Hubungi Kami"
  description="Hubungi pengelola Medan Gyn Surgery lewat email atau Instagram untuk pertanyaan umum, masukan, atau koreksi materi edukasi."
>
  <h1>Hubungi Kami</h1>
  <p class="lead">
    Punya <strong>pertanyaan umum</strong>, <strong>masukan</strong>, atau
    menemukan informasi yang perlu dikoreksi? Anda dapat menghubungi pengelola
    Medan Gyn Surgery melalui email atau Instagram berikut.
  </p>

  <Callout type="warn" title="Bukan untuk keadaan darurat atau konsultasi pribadi">
    <p>
      Saluran ini <strong>tidak ditujukan untuk keadaan darurat medis</strong>
      maupun <strong>konsultasi atau diagnosis pribadi</strong>. Bila Anda
      memiliki keluhan kesehatan, silakan menemui dokter atau fasilitas kesehatan.
      Untuk keadaan gawat darurat, segera ke <strong>Instalasi Gawat Darurat
      (IGD)</strong> rumah sakit terdekat.
    </p>
  </Callout>

  <div class="contact-methods">
    <a class="contact-card" href={emailHref}>
      <span class="contact-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path d="m3.5 7 8.5 6 8.5-6" />
        </svg>
      </span>
      <span class="contact-body">
        <span class="contact-label">Email</span>
        <span class="contact-value">{email}</span>
      </span>
      <span class="contact-cta">Kirim email →</span>
    </a>

    <a class="contact-card" href={igHref} target="_blank" rel="noopener noreferrer">
      <span class="contact-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="5.5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="contact-body">
        <span class="contact-label">Instagram</span>
        <span class="contact-value">@{igUser}</span>
      </span>
      <span class="contact-cta">Buka Instagram →</span>
    </a>
  </div>

  <p class="contact-copy-row">
    <button type="button" class="btn btn--ghost js-copy" data-copy={email}>
      ⧉ Salin alamat email
    </button>
  </p>

  <Callout type="info" title="Mohon dimaklumi">
    <p>
      Kami berusaha membaca setiap pesan dan masukan, terutama dari sesama tenaga
      medis untuk menjaga akurasi materi. Namun mohon maaf bila tidak selalu dapat
      membalas satu per satu.
    </p>
  </Callout>
</BaseLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.js-copy')) {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = '✓ Email tersalin';
        setTimeout(() => (btn.textContent = original), 1600);
      } catch {
        /* abaikan */
      }
    });
  }
</script>
