---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareQR from '../../components/ShareQR.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const { Content, headings } = await render(topic);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(d);
const shareUrl = new URL(withBase(`/topik/${topic.id}`), Astro.site).href;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={topic.data.title} description={topic.data.summary}>
  <a class="backlink" href={withBase('/')}>← Semua topik</a>

  <article class="article">
    <p class="eyebrow">{topic.data.category}</p>
    <h1>{topic.data.title}</h1>
    <p class="lead">{topic.data.summary}</p>

    <p class="topic-updated">Diperbarui {fmt(topic.data.updatedDate)}</p>

    <ShareQR url={shareUrl} />

    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Daftar isi">
          <strong>Daftar isi</strong>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <Content />

    <hr />
    <Disclaimer />
  </article>

  <a class="backlink" href={withBase('/')}>← Semua topik</a>
</BaseLayout>
