---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';

const topics = (await getCollection('topics', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(d);

// Kelompokkan topik per kategori (urutan kategori ditentukan di bawah).
const CATEGORY_ORDER = ['Kanker Ginekologi', 'Pengobatan & Prosedur'];
const byCategory = (cat: string) =>
  topics.filter((t) => t.data.category === cat);
const extraCats = [...new Set(topics.map((t) => t.data.category))].filter(
  (c) => !CATEGORY_ORDER.includes(c)
);
const categories = [
  ...CATEGORY_ORDER.filter((c) => byCategory(c).length > 0),
  ...extraCats,
];
---

<BaseLayout
  title="SAGITA"
  description="SAGITA (Sahabat Ginekologi Onkologi): edukasi pasien tentang kanker organ reproduksi perempuan dengan bahasa yang mudah dipahami."
>
  <section style="margin:1.4rem 0 0.5rem">
    <p class="eyebrow">Edukasi Pasien Ginekologi Onkologi</p>
    <h1>Memahami kanker perempuan dengan bahasa yang mudah</h1>
    <p class="lead">
      <strong>SAGITA</strong> — Sahabat Ginekologi Onkologi — membantu Anda dan
      keluarga memahami penyakit, pemeriksaan, dan pengobatan kanker pada organ
      reproduksi perempuan. Langkah demi langkah, tanpa istilah yang
      membingungkan.
    </p>
  </section>

  {
    categories.map((cat) => (
      <>
        <h2>{cat}</h2>
        <div class="cards">
          {byCategory(cat).map((t) => (
            <TopicCard
              href={withBase(`/topik/${t.id}`)}
              icon={t.data.icon}
              title={t.data.title}
              summary={t.data.summary}
              validated={t.data.validated}
              meta={`Diperbarui ${fmt(t.data.updatedDate)}`}
            />
          ))}
          {cat === 'Kanker Ginekologi' && (
            <TopicCard
              icon="🩺"
              title="Topik lain menyusul"
              summary="Topik kanker ginekologi lain (mis. kanker rahim) sedang disiapkan dan akan ditambahkan secara bertahap."
              soon
            />
          )}
        </div>
      </>
    ))
  }

  <h2>Jelajahi lainnya</h2>
  <div class="cards">
    <TopicCard
      href={withBase('/kamus')}
      icon="📖"
      title="Kamus Istilah"
      summary="Arti istilah medis yang sering Anda dengar, dijelaskan dengan bahasa sehari-hari. Bisa dicari."
      noBadge
    />
    <TopicCard
      href={withBase('/tentang')}
      icon="🩺"
      title="Tentang SAGITA"
      summary="Tujuan situs, cara memakainya, dan catatan penting sebelum membaca."
      noBadge
    />
  </div>

  <Disclaimer />
</BaseLayout>
