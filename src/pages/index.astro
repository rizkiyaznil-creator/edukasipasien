---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';

const topics = (await getCollection('topics', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(d);

// Kelompokkan topik per kategori (urutan kategori ditentukan di bawah).
const CATEGORY_ORDER = [
  'Kanker Ginekologi',
  'Pencegahan & Deteksi Dini',
  'Ginekologi Umum',
  'Pengobatan & Prosedur',
];
const byCategory = (cat: string) =>
  topics.filter((t) => t.data.category === cat);
const extraCats = [...new Set(topics.map((t) => t.data.category))].filter(
  (c) => !CATEGORY_ORDER.includes(c)
);
const categories = [
  ...CATEGORY_ORDER.filter((c) => byCategory(c).length > 0),
  ...extraCats,
];

// Data pencarian topik untuk kotak "Cari" di beranda (difilter di sisi klien).
const searchItems = topics.map((t) => ({
  title: t.data.title,
  category: t.data.category,
  icon: t.data.icon,
  url: withBase(`/topik/${t.id}`),
  terms: `${t.data.title} ${t.data.category} ${t.data.summary}`.toLowerCase(),
}));
---

<BaseLayout
  title="Temant"
  description="Temant (Sahabat Ginekologi Onkologi): edukasi pasien tentang kanker organ reproduksi perempuan dengan bahasa yang mudah dipahami."
>
  <section style="margin:1.4rem 0 0.5rem">
    <p class="eyebrow">Edukasi Pasien Ginekologi Onkologi</p>
    <h1>Memahami kanker perempuan dengan bahasa yang mudah</h1>
    <p class="lead">
      <strong>Temant</strong> — Sahabat Ginekologi Onkologi — membantu Anda dan
      keluarga memahami penyakit, pemeriksaan, dan pengobatan kanker pada organ
      reproduksi perempuan. Langkah demi langkah, tanpa istilah yang
      membingungkan.
    </p>
  </section>

  <div class="topic-search" id="topic-search" role="search">
    <span class="ic" aria-hidden="true">🔎</span>
    <input
      id="topic-q"
      type="search"
      autocomplete="off"
      placeholder="Cari topik… (mis. serviks, kista, kemoterapi)"
      aria-label="Cari topik"
      aria-controls="topic-results"
      aria-expanded="false"
      aria-autocomplete="list"
    />
    <ul
      id="topic-results"
      class="topic-results"
      role="listbox"
      aria-label="Hasil pencarian topik"
      hidden
    >
      {
        searchItems.map((s) => (
          <li class="topic-result" role="option" data-search={s.terms}>
            <a href={s.url}>
              <span class="tr-ic" aria-hidden="true">{s.icon}</span>
              <span class="tr-txt">
                <strong>{s.title}</strong>
                <small>{s.category}</small>
              </span>
            </a>
          </li>
        ))
      }
      <li class="tr-empty" hidden>Tidak ada topik yang cocok. Coba kata kunci lain.</li>
    </ul>
  </div>

  {
    categories.map((cat) => (
      <>
        <h2>{cat}</h2>
        <div class="cards">
          {byCategory(cat).map((t) => (
            <TopicCard
              href={withBase(`/topik/${t.id}`)}
              icon={t.data.icon}
              title={t.data.title}
              summary={t.data.summary}
              validated={t.data.validated}
              meta={`Diperbarui ${fmt(t.data.updatedDate)}`}
            />
          ))}
          {cat === 'Kanker Ginekologi' && (
            <TopicCard
              icon="🩺"
              title="Topik lain menyusul"
              summary="Topik kanker ginekologi lain (mis. kanker vulva atau vagina) sedang disiapkan dan akan ditambahkan secara bertahap."
              soon
            />
          )}
        </div>
      </>
    ))
  }

  <h2>Jelajahi lainnya</h2>
  <div class="cards">
    <TopicCard
      href={withBase('/kamus')}
      icon="📖"
      title="Kamus Istilah"
      summary="Arti istilah medis yang sering Anda dengar, dijelaskan dengan bahasa sehari-hari. Bisa dicari."
      noBadge
    />
    <TopicCard
      href={withBase('/tentang')}
      icon="🩺"
      title="Tentang Temant"
      summary="Tujuan situs, cara memakainya, dan catatan penting sebelum membaca."
      noBadge
    />
  </div>

  <Disclaimer />

  <style>
    .topic-search {
      position: relative;
      margin: 1.25rem 0 0.5rem;
    }
    .topic-search > .ic {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      opacity: 0.55;
      pointer-events: none;
    }
    .topic-search input {
      width: 100%;
      padding: 0.8rem 1rem 0.8rem 2.5rem;
      font-size: 1rem;
      color: inherit;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
    }
    .topic-search input:focus-visible {
      outline: 2px solid var(--c-primary);
      outline-offset: 1px;
      border-color: var(--c-primary);
    }
    .topic-results {
      list-style: none;
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 0.3rem);
      z-index: 30;
      margin: 0;
      padding: 0.3rem;
      background: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
      box-shadow: 0 10px 30px rgba(20, 32, 43, 0.15);
      max-height: 340px;
      overflow-y: auto;
    }
    .topic-results a {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.55rem 0.6rem;
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
    }
    .topic-results a:hover,
    .topic-results li.is-active > a {
      background: var(--c-primary-soft);
    }
    .topic-results .tr-ic {
      font-size: 1.25rem;
      line-height: 1;
    }
    .topic-results .tr-txt {
      display: flex;
      flex-direction: column;
    }
    .topic-results .tr-txt small {
      color: var(--c-text-muted);
      font-size: 0.8rem;
    }
    .topic-results .tr-empty {
      padding: 0.65rem;
      text-align: center;
      color: var(--c-text-muted);
    }
  </style>

  <script>
    const box = document.getElementById('topic-search');
    const input = document.getElementById('topic-q') as HTMLInputElement | null;
    const results = document.getElementById('topic-results');
    if (box && input && results) {
      const items = Array.from(
        results.querySelectorAll<HTMLLIElement>('.topic-result')
      );
      const empty = results.querySelector<HTMLLIElement>('.tr-empty');
      let activeIdx = -1;

      const visible = () => items.filter((li) => !li.hidden);

      const setActive = (idx: number) => {
        activeIdx = idx;
        const vis = visible();
        items.forEach((li) => li.classList.remove('is-active'));
        if (idx >= 0 && vis[idx]) {
          vis[idx].classList.add('is-active');
          vis[idx].scrollIntoView({ block: 'nearest' });
        }
      };

      const open = () => {
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
      };
      const close = () => {
        results.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        setActive(-1);
      };

      const update = () => {
        const q = input.value.trim().toLowerCase();
        if (q.length < 2) {
          close();
          return;
        }
        let shown = 0;
        for (const li of items) {
          const match = (li.dataset.search || '').includes(q);
          li.hidden = !match;
          if (match) shown++;
        }
        if (empty) empty.hidden = shown > 0;
        setActive(-1);
        open();
      };

      input.addEventListener('input', update);
      input.addEventListener('focus', () => {
        if (input.value.trim().length >= 2) update();
      });
      input.addEventListener('keydown', (e) => {
        const vis = visible();
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (results.hidden) update();
          setActive(Math.min(activeIdx + 1, vis.length - 1));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(Math.max(activeIdx - 1, 0));
        } else if (e.key === 'Enter') {
          const target = activeIdx >= 0 ? vis[activeIdx] : vis[0];
          const link = target && target.querySelector('a');
          if (link) {
            e.preventDefault();
            window.location.href = link.href;
          }
        } else if (e.key === 'Escape') {
          close();
        }
      });
      document.addEventListener('click', (e) => {
        if (!box.contains(e.target as Node)) close();
      });
    }
  </script>
</BaseLayout>
