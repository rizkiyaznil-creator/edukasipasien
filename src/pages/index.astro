---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';

const topics = (await getCollection('topics', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(d);

// Kelompokkan topik per kategori (urutan kategori ditentukan di bawah).
const CATEGORY_ORDER = [
  'Kanker Ginekologi',
  'Pencegahan & Deteksi Dini',
  'Ginekologi Umum',
  'Pengobatan & Prosedur',
];
const byCategory = (cat: string) =>
  topics.filter((t) => t.data.category === cat);
const extraCats = [...new Set(topics.map((t) => t.data.category))].filter(
  (c) => !CATEGORY_ORDER.includes(c)
);
const categories = [
  ...CATEGORY_ORDER.filter((c) => byCategory(c).length > 0),
  ...extraCats,
];

// Ikon kecil pembeda untuk tiap kategori di beranda.
const catIcon: Record<string, string> = {
  'Kanker Ginekologi': '🎗️',
  'Pencegahan & Deteksi Dini': '🛡️',
  'Ginekologi Umum': '🌿',
  'Pengobatan & Prosedur': '🩺',
};
---

<BaseLayout
  title="Medan Gyn Surgery"
  description="Medan Gyn Surgery (Sahabat Ginekologi Onkologi): edukasi pasien tentang kanker organ reproduksi perempuan dengan bahasa yang mudah dipahami."
>
  <section class="hero" style="margin:1.4rem 0 0.5rem">
    <svg class="hero-botanical" viewBox="0 0 200 260" fill="none" aria-hidden="true">
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M150 20 C 120 70, 100 130, 70 240" />
        <path d="M138 48 q -22 -10 -40 -4" /><path d="M138 48 q 14 -16 36 -16" />
        <path d="M126 82 q -24 -8 -42 0" /><path d="M126 82 q 12 -18 34 -20" />
        <path d="M112 120 q -24 -6 -42 4" /><path d="M112 120 q 10 -18 32 -22" />
        <path d="M98 162 q -22 -4 -40 8" /><path d="M98 162 q 10 -18 30 -22" />
        <path d="M86 202 q -20 -2 -36 12" /><path d="M86 202 q 8 -16 26 -22" />
      </g>
    </svg>
    <p class="eyebrow">Edukasi Pasien Ginekologi Onkologi</p>
    <h1>Memahami kanker perempuan dengan bahasa yang <span class="hl">mudah</span></h1>
    <p class="lead">
      <strong>Medan Gyn Surgery</strong> — Sahabat Ginekologi Onkologi — membantu Anda dan
      keluarga memahami penyakit, pemeriksaan, dan pengobatan kanker pada organ
      reproduksi perempuan. Langkah demi langkah, tanpa istilah yang
      membingungkan.
    </p>
    <p style="margin:0.7rem 0 0;font-size:0.9rem;color:var(--c-text-muted)">
      Maintained and curated by
      <strong>dr. Muhammad Rizki Yaznil, M.Ked(OG), SpOG.Subsp(Onk)</strong>
    </p>
    <div class="hero-actions">
      <a class="btn" href="#topik">Jelajahi topik</a>
      <a class="btn btn--ghost" href={withBase('/kamus')}>Buka Kamus</a>
    </div>
  </section>

  <span id="topik" aria-hidden="true"></span>

  {
    categories.map((cat) => (
      <>
        <h2>{catIcon[cat] && <span class="cat-ic" aria-hidden="true">{catIcon[cat]} </span>}{cat}</h2>
        <div class="cards">
          {byCategory(cat).map((t) => (
            <TopicCard
              href={withBase(`/topik/${t.id}`)}
              icon={t.data.icon}
              title={t.data.title}
              summary={t.data.summary}
              validated={t.data.validated}
              meta={`Diperbarui ${fmt(t.data.updatedDate)}`}
            />
          ))}
          {cat === 'Kanker Ginekologi' && (
            <TopicCard
              icon="🩺"
              title="Topik lain menyusul"
              summary="Topik kanker ginekologi lain (mis. kanker vulva atau vagina) sedang disiapkan dan akan ditambahkan secara bertahap."
              soon
            />
          )}
        </div>
      </>
    ))
  }

  <h2>Jelajahi lainnya</h2>
  <div class="cards">
    <TopicCard
      href={withBase('/kamus')}
      icon="📖"
      title="Kamus Istilah"
      summary="Arti istilah medis yang sering Anda dengar, dijelaskan dengan bahasa sehari-hari. Bisa dicari."
      noBadge
    />
    <TopicCard
      href={withBase('/tentang')}
      icon="🩺"
      title="Tentang Medan Gyn Surgery"
      summary="Tujuan situs, cara memakainya, dan catatan penting sebelum membaca."
      noBadge
    />
    <TopicCard
      href={withBase('/hubungi')}
      icon="✉️"
      title="Hubungi Kami"
      summary="Kirim pertanyaan umum, masukan, atau koreksi materi lewat email atau Instagram."
      noBadge
    />
  </div>

  <Disclaimer />
</BaseLayout>
